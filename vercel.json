{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "display-capture=(self), microphone=(self), camera=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://discord.com https://*.discord.app https://*.discordsays.com;"
        }
      ]
    }
  ]
}
